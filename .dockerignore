# Keep the build context small and leak-proof. The Dockerfile COPYs only pyproject/uv.lock/src/docker,
# but everything here is also excluded from the context sent to the daemon.
.git
.github
.venv
build/
dist/
**/__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.tar
*.tar.gz

# secrets — mirrors the .gitignore block. The Dockerfile COPYs a narrow set today, but the build
# CONTEXT is what gets shipped to the daemon (and any future COPY), so exclude them here too.
*.pem
*.key
*.ppk
id_rsa*
id_ed25519*
*.ovpn
.env
.env.*
creds.json
*_creds.json
*.kdbx
/oscprecon/
boxes/TRACKER.md

# private / maintainer-only — must NEVER be baked into a distributable image
HANDOFF.local.md
.claude/
walkthroughs/
prompts/
share/
sc_audit.log
autosave.sh
mirror.sh

# not needed at runtime
tests/
docs/
boxes/
packaging/
PROGRESS.md
PROJECT_MAP.md
ROADMAP.md

# runtime data / local docker state
.nabu/
.nabu-data/
