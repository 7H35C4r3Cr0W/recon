# syntax=docker/dockerfile:1
# Nabu Agent frontend — build the React+Vite+TS SPA, serve static assets via nginx, reverse-proxy
# /api and /ws to the api service. Context is the repo root; the SPA lives at nabu-agent/frontend.
FROM node:22-alpine AS build
WORKDIR /app
COPY nabu-agent/frontend/package.json nabu-agent/frontend/package-lock.json* ./
RUN npm install --no-audit --no-fund
COPY nabu-agent/frontend/ ./
RUN npm run build            # -> /app/dist

FROM nginx:1.27-alpine
COPY nabu-agent/deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
# TLS terminates here (mount internal-CA cert/key at /etc/nginx/tls) or front with the org LB.
EXPOSE 8443
