# Nabu Agent configuration (12-factor). Copy to .env (gitignored). Values load via pydantic-settings
# (nabu_agent.settings.Settings). Secrets that must not sit in env (db password) go through docker
# `secrets:` files instead; everything here is non-secret config or dev-only convenience.

# --- Core ---
NABU_ENV=production
NABU_AGENT_BIND=127.0.0.1                  # internal interface only; never 0.0.0.0 in prod
NABU_WORKSPACE=/workspace
NABU_AGENT_WORKSPACE_ROOT=/workspace   # engine-adapter workspace root (one Profile dir per project)                   # engine Profiles/findings/audit live here (shared vol)
NABU_AGENT_WORKERS=2
NABU_USE_ARQ=true                           # runs execute on the arq worker pool (prod); dev/tests run in-process
NABU_RETENTION_ENABLED=true                 # hourly housekeeping cron (worker)
NABU_RETENTION_RUN_EVENTS_DAYS=30           # drop finished runs' event stream after N days
NABU_MAX_RUNS_PER_PROJECT=200               # keep only the newest N runs per project

# --- Datastores ---
POSTGRES_USER=nabu
POSTGRES_DB=nabu
DATABASE_URL=postgresql+asyncpg://nabu:@postgres:5432/nabu   # password injected from secret at boot
REDIS_URL=redis://redis:6379/0

# --- Auth (internal login) ---
NABU_SESSION_SECRET=                        # 32+ random bytes; REQUIRED, no default in prod
# First local admin, seeded on first boot when OIDC is off (idempotent — no-op if any user
# exists). CHANGE THE PASSWORD before production; the app refuses to boot in prod on the default.
NABU_ADMIN_EMAIL=admin@corp.local
NABU_ADMIN_PASSWORD=change-me-now

NABU_SESSION_TTL_MIN=480
NABU_OIDC_ISSUER=                           # optional: org IdP base URL → enables "Sign in with SSO"
NABU_OIDC_CLIENT_ID=                        # OAuth client id from the IdP
NABU_OIDC_CLIENT_SECRET=                    # from the secret store; never commit
NABU_OIDC_SCOPES=openid email profile
NABU_OIDC_REDIRECT_URL=                     # optional override; else derived (…/api/auth/oidc/callback)
NABU_OIDC_FIRST_USER_ADMIN=true             # first SSO user becomes admin (SSO-only bootstrap)
# Register this back-channel logout URI at the IdP: https://<host>/api/auth/oidc/backchannel-logout

# --- BRAIN: OpenAI-compatible LLM provider (owner attaches the internal endpoint) ---
# The DEFAULT adapter is OpenAI-compatible; fully swappable via NABU_LLM_PROVIDER.
NABU_LLM_PROVIDER=openai_compatible
NABU_LLM_BASE_URL=https://llm.internal.example/v1
NABU_LLM_API_KEY=                           # from secret store; never commit
NABU_LLM_MODEL=gpt-5.1
NABU_LLM_TIMEOUT_S=60
NABU_LLM_MAX_TOKENS=4096

# --- SAFETY GATES (mirror the engine's config; OFF/gated by default) ---
NABU_SPRAY_ENABLED=false                    # per-project spray stays human-gated; global kill-switch
NABU_EXPLOIT_ENABLED=false                  # NEVER let an agent auto-set exploit=True
NABU_AUTONOMY=recon_only                    # recon_only | recon_plus_suggest ; attack is never auto

# --- Egress / sandboxing ---
NABU_ALLOWED_EGRESS_CIDRS=                  # optional belt-and-braces host firewall hint (see docs)

# --- Observability ---
NABU_LOG_LEVEL=INFO
NABU_LOG_FORMAT=json
OTEL_EXPORTER_OTLP_ENDPOINT=                # optional: internal collector for run/agent traces
OTEL_SERVICE_NAME=nabu-agent
